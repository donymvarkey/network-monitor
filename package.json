{
  "name": "network-monitor",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter web prisma migrate deploy",
    "db:seed": "pnpm --filter web db:seed",
    "lint": "eslint .",
    "typecheck": "pnpm -r exec tsc --noEmit -p .",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter web test:integration",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm --filter web exec prisma validate && pnpm --filter web build"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "typescript-eslint": "^8.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "typescript": "^5.6.3"
  }
}
