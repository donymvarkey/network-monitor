# PostgreSQL
POSTGRES_USER=netmon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=netmon
DATABASE_URL=postgresql://netmon:change-me@postgres:5432/netmon?schema=public
# Redis
REDIS_URL=redis://redis:6379
# Auth (generate with: openssl rand -base64 32)
SESSION_SECRET=
# Initial admin created by the seed script
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=
# Realtime gateway
REALTIME_PORT=4001
# Where the web app forwards /socket.io (browser connects same-origin). Docker uses nginx instead.
REALTIME_INTERNAL_URL=http://localhost:4001
# Router credential encryption (openssl rand -base64 32). Losing it means re-entering router passwords.
ROUTER_CREDENTIALS_KEY=

# ---------------- Phase 6 ----------------
APP_VERSION=0.6.0
# Comma-separated external origins allowed to call the API/realtime from a browser (normally empty: same origin).
APP_ORIGIN=
# Sessions: absolute maximum and idle timeout
SESSION_MAX_AGE_HOURS=12
SESSION_IDLE_MINUTES=120
# Session cookie "Secure" flag. Browsers drop Secure cookies on plain http (except localhost),
# so keep false for http://<lan-ip>:3000 and set true once HTTPS is enabled.
COOKIE_SECURE=false
COLLECTOR_RATE_LIMIT_PER_MIN=600

# Email notifications (worker). Leave SMTP_HOST empty to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_ATTEMPTS=5
ALERT_TICK_MS=30000

# Retention in days. 0 = keep forever (default). Device inventory is never deleted.
OBSERVATION_RETENTION_DAYS=0
DEVICE_METRIC_RETENTION_DAYS=0
ROUTER_METRIC_RETENTION_DAYS=0
INTERFACE_METRIC_RETENTION_DAYS=2
TRAFFIC_FLOW_RETENTION_DAYS=0
EVENT_RETENTION_DAYS=0
RESOLVED_ALERT_RETENTION_DAYS=0
NOTIFICATION_RETENTION_DAYS=0
AUDIT_LOG_RETENTION_DAYS=0
JOB_FAILURE_RETENTION_DAYS=30

# Backups (backup service)
BACKUP_PATH=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Published ports (nginx). Use HTTP_BIND=127.0.0.1 to keep it local-only.
HTTP_BIND=0.0.0.0
HTTP_PORT=3000
HTTPS_PORT=3443
# HTTPS: NGINX_CONF=./docker/nginx/https.conf
NGINX_CONF=./docker/nginx.conf
