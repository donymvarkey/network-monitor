COLLECTOR_ID=
COLLECTOR_TOKEN=
API_BASE_URL=http://127.0.0.1:3000
# Your subnet(s), e.g. the R15 LAN. Find it with: ip -4 addr
NETWORK_CIDRS=
# Distinct name per physical LAN, e.g. r15-lan / isp-lan. Keeps overlapping ranges separate.
NETWORK_CONTEXT=
SCAN_INTERVAL=300
PING_TIMEOUT=1000
ENABLE_ARP=true
ENABLE_ICMP=true
ENABLE_NMAP=false
# Phase 5: NetFlow v5 receiver. Point your router/switch NetFlow export at this host:NETFLOW_PORT.
# ARP/ICMP never measure bandwidth; without a flow exporter, per-device traffic stays "unavailable".
ENABLE_NETFLOW=false
NETFLOW_PORT=2055
# Comma-separated exporter IPs to accept (empty = accept any exporter on the LAN)
NETFLOW_EXPORTERS=
NETFLOW_FLUSH_SEC=60
